# ---- Required Backend Configuration ----
# Comma-separated API keys (at least 2). Assigned key_1, key_2, ... in this order.
LLM_API_KEYS=your_primary_api_key_here,your_secondary_api_key_here

# SQLite database location (under Docker volume /data in containers)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins (add your deployed frontend URL in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true to enable the X-Simulate-Failure failover test hook (must be true in deployment)
ENABLE_FAILURE_SIMULATION=true

# ---- Optional Gateway Configuration ----
# LiteLLM model string (examples: gemini/gemini-3.8-flash, groq/llama-3.1-8b-instant, openai/gpt-4o-mini)
LLM_MODEL=gemini/gemini-3.8-flash

# Optional comma-separated per-key models matching LLM_API_KEYS (leave blank to use LLM_MODEL for all keys)
LLM_MODELS=

# LiteLLM built-in response cache settings ("local" for in-memory or "disk")
CACHE_ENABLED=true
CACHE_TYPE=local
DISK_CACHE_DIR=/data/litellm_cache

# Default system prompt used when the client does not supply system_prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# Per-key upstream timeout in seconds before failing over to the next key
LLM_TIMEOUT_SECONDS=30

# ---- Frontend Configuration ----
# Public base URL of the backend API
VITE_API_URL=http://localhost:8000
